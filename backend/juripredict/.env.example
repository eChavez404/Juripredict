DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
FIELD_ENCRYPTION_KEY=troque-por-outra-chave-longa-e-estavel
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOW_ALL_ORIGINS=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost

# Sem DB_HOST, o desenvolvimento e os testes usam SQLite.
# Em produção, prefira DATABASE_URL e não preencha os campos DB_* abaixo.
# DATABASE_URL=postgresql://usuario:senha@host:5432/juripredict_db?sslmode=require
DB_NAME=juripredict_db
DB_USER=postgres
DB_PASSWORD=yourpassword
# DB_HOST=localhost
DB_PORT=5432

# Ative somente depois de preencher todas as credenciais abaixo.
USE_R2_STORAGE=false
AWS_ACCESS_KEY_ID=your-r2-access-key
AWS_SECRET_ACCESS_KEY=your-r2-secret-key
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com

# --- E-mail transacional (convite, recuperação de senha, lembrete de prazo) ---
# Sem EMAIL_HOST, os e-mails vão para o console (útil em desenvolvimento).
# EMAIL_HOST=smtp.seuprovedor.com
EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=JuriPredict <nao-responda@seudominio.com.br>
# Base dos links enviados por e-mail. No Render é deduzida do host.
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_TIMEOUT=3600
CONVITE_VALIDADE_DIAS=7

# --- Lembretes de prazo: agende "python manage.py enviar_lembretes" de hora em hora ---
LEMBRETE_ANTECEDENCIA_HORAS=24

# --- Arquivos enviados ---
UPLOAD_MAX_MB=10
# Teto de documentos anexados a cada processo.
# DOCUMENTOS_MAX_POR_PROCESSO=50

# Tokens de API (agentes/MCP): validade padrão em dias e máximo de ativos por pessoa.
# API_TOKEN_VALIDADE_DIAS=90
# API_TOKEN_MAX_ATIVOS=5

# --- Segurança ---
# Quantos proxies existem entre o cliente e a aplicação (Render e Fly: 1).
# NUM_PROXIES=1

# --- Monitoramento de erros (opcional). O corpo das requisições nunca é enviado. ---
# Acompanhamento de processos pelo DataJud (chave pública da wiki do CNJ).
# DATAJUD_API_KEY=

# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0

# Versão dos Termos de Uso e da Política de Privacidade vigentes.
# TERMOS_VERSAO=2026-10

# Validade do link de confirmação de e-mail, em horas.
# VERIFICACAO_EMAIL_HORAS=72

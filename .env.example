# Copie para .env e preencha. O .env nao e versionado.

# Aplicacao local com Docker Compose
POSTGRES_PASSWORD=gere-uma-senha-local-forte
DJANGO_SECRET_KEY=gere-uma-chave-longa-e-aleatoria
# Esta chave cifra CPF/CNPJ e deve permanecer estável. Guarde-a fora do Git.
FIELD_ENCRYPTION_KEY=gere-outra-chave-longa-e-aleatoria

# Extracao de variaveis de conteudo (dataset/pipeline/extrair_llm.py)
GEMINI_API_KEY=

# Metadados processuais do CNJ (dataset/pipeline/coletar_datajud.py)
DATAJUD_API_KEY=

# Sessao do FALCAO obtida no navegador; so preencher se o bootstrap
# automatico da sessao publica falhar (dataset/collector/session.py)
FALCAO_SESSION_ID=

# Segredo compartilhado com o backend Django (mesmo valor nos dois). Sem ele, a API recusa tudo.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENTE_SEGREDO=

# LLM (formato provedor:modelo, lido por init_chat_model)
LLM_MODEL=google_genai:gemini-3.8-flash
GOOGLE_API_KEY=

# Embeddings (Google). A dimensão precisa ser igual à do índice no Pinecone.
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768

# Pinecone (sem chave e índice, o agente roda sem casos próximos e avisa)
PINECONE_API_KEY=
PINECONE_INDEX=
PINECONE_NAMESPACE=

# Langfuse (sem as duas chaves, nada é enviado)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# Opcionais
# HOST=127.0.0.1
# PORT=8001
# LLM_PROVIDER_TIMEOUT_SECONDS=120
